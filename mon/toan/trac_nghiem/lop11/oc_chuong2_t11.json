   "questions": [
    {
     "content": "Cho cấp số cộng $(u_n)$ có $u_1=3$ và $u_4=12$.",
     "imageUrl": "",
     "statements": [
      {
       "text": "Công sai $d=3$.",
       "correct": true,
       "expl": "$u_4=u_1+3d\\Rightarrow d=3$."
      },
      {
       "text": "$(u_n)$ là dãy số tăng.",
       "correct": true,
       "expl": "$u_{n+1}-u_n=d=3>0$."
      },
      {
       "text": "$u_{20}=63$.",
       "correct": false,
       "expl": "$u_{20}=3+19\\cdot 3=60$."
      },
      {
       "text": "Tổng 20 số hạng đầu bằng 630.",
       "correct": true,
       "expl": "$S_{20}=\\frac{20(3+60)}{2}=630$."
      }
     ]
    },
    {
     "content": "Anh Hùng gửi 100 triệu đồng vào ngân hàng theo hình thức lãi kép, lãi suất $6\\%$ mỗi năm. Gọi $u_n$ (triệu đồng) là số tiền anh có sau $n$ năm.",
     "imageUrl": "",
     "statements": [
      {
       "text": "$(u_n)$ là cấp số nhân có công bội $1{,}06$.",
       "correct": true,
       "expl": "$u_n=1{,}06\\,u_{n-1}$, $u_n=100\\cdot 1{,}06^n$."
      },
      {
       "text": "Sau 3 năm anh Hùng có 118 triệu đồng.",
       "correct": false,
       "expl": "$u_3=100\\cdot 1{,}06^3\\approx 119{,}1$ (118 triệu là cách tính lãi đơn)."
      },
      {
       "text": "Nếu cuối mỗi năm (sau khi nhận lãi) anh rút ra 10 triệu đồng thì sau năm thứ nhất còn 96 triệu đồng và số tiền còn lại $v_n$ thỏa $v_{n+1}=1{,}06v_n-10$.",
       "correct": true,
       "expl": "$v_1=106-10=96$; mỗi năm: nhân $1{,}06$ rồi trừ 10."
      },
      {
       "text": "Với cách rút đó, $(v_n)$ là dãy số giảm.",
       "correct": true,
       "expl": "$v_{n+1}-v_n=0{,}06v_n-10$; $v_1=96$ nên $0{,}06v_1-10<0$, và $v_n$ giảm thì $0{,}06v_n-10$ càng âm."
      }
     ]
    }
   ]

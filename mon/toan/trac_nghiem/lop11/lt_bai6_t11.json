      {
       "l": "A",
       "t": "$u_n=2n-5$"
      },
      {
       "l": "B",
       "t": "$u_n=2n-3$"
      },
      {
       "l": "C",
       "t": "$u_n=-3n+2$"
      },
      {
       "l": "D",
       "t": "$u_n=-3+2n$"
      }
     ],
     "correct": "A",
     "expl": "$u_n=-3+2(n-1)=2n-5$."
    },
    {
     "content": "Tổng $n$ số hạng đầu của cấp số cộng $(u_n)$ là",

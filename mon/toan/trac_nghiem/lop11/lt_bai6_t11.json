   "questions": [
    {
     "content": "Cho cấp số cộng $(u_n)$ có $u_1=4$ và $u_5=16$.",
     "imageUrl": "",
     "statements": [
      {
       "text": "Công sai $d=3$.",
       "correct": true,
       "expl": "$u_5=u_1+4d\\Rightarrow 16=4+4d\\Rightarrow d=3$."
      },
      {
       "text": "$u_{10}=31$.",
       "correct": true,
       "expl": "$u_{10}=4+9\\cdot 3=31$."
      },
      {
       "text": "$S_{10}=185$.",
       "correct": false,
       "expl": "$S_{10}=\\frac{10(4+31)}{2}=175$."
      },
      {
       "text": "Số $100$ là một số hạng của cấp số cộng này.",
       "correct": true,
       "expl": "$4+3(n-1)=100\\Leftrightarrow n=33\\in\\mathbb{N}^*$."
      }
     ]
    },
    {
     "content": "Một hội trường ở xã Vĩnh Thạnh có 15 hàng ghế; hàng đầu có 12 ghế, mỗi hàng sau nhiều hơn hàng trước 2 ghế.",
     "imageUrl": "",
     "statements": [
      {
       "text": "Hàng thứ 5 có 20 ghế.",
       "correct": true,
       "expl": "$u_5=12+4\\cdot 2=20$."
      },
      {
       "text": "Hàng cuối có 42 ghế.",
       "correct": false,
       "expl": "$u_{15}=12+14\\cdot 2=40$."
      },
      {
       "text": "Hội trường có tất cả 390 ghế.",
       "correct": true,
       "expl": "$S_{15}=\\frac{15(12+40)}{2}=390$."
      },
      {
       "text": "Nếu muốn có ít nhất 500 ghế (vẫn theo quy luật trên) thì cần tối thiểu 18 hàng.",
       "correct": true,
       "expl": "$S_n=n(n+11)\\ge 500$; $S_{17}=476<500$, $S_{18}=522\\ge 500$."
      }
     ]
    }
   ]
  },

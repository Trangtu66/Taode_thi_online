       "t": "$22$"
      },
      {
       "l": "B",
       "t": "$17$"
      },
      {
       "l": "C",
       "t": "$12$"
      },
      {
       "l": "D",
       "t": "$20$"
      }
     ],
     "correct": "B",
     "expl": "$u_4=u_1+3d=2+15=17$."
    },
    {
     "content": "Dãy số hữu hạn nào sau đây là cấp số cộng?",

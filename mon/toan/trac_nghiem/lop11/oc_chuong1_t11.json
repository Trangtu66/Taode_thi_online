   "questions": [
    {
     "content": "Đổi số đo góc $\\frac{3\\pi}{4}$ rad sang độ, ta được",
     "imageUrl": "",
     "options": [
      {
       "l": "A",
       "t": "$120^\\circ$"
      },
      {
       "l": "B",
       "t": "$135^\\circ$"
      },
      {
       "l": "C",
       "t": "$150^\\circ$"
      },
      {
       "l": "D",
       "t": "$45^\\circ$"
      }
     ],
     "correct": "B",
     "expl": "$\\frac{3\\pi}{4}\\cdot\\frac{180^\\circ}{\\pi}=135^\\circ$."
    },
    {
     "content": "Cho góc $\\alpha$ thỏa mãn $\\frac{\\pi}{2}<\\alpha<\\pi$. Khẳng định nào sau đây đúng?",
     "imageUrl": "",
     "options": [
      {
       "l": "A",
       "t": "$\\tan\\alpha>0$"
      },
      {
       "l": "B",
       "t": "$\\sin\\alpha<0$, $\\cos\\alpha>0$"
      },
      {
       "l": "C",
       "t": "$\\sin\\alpha>0$, $\\cos\\alpha>0$"
      },
      {
       "l": "D",
       "t": "$\\sin\\alpha>0$, $\\cos\\alpha<0$"
      }
     ],
     "correct": "D",
     "expl": "Điểm biểu diễn thuộc góc phần tư thứ II: tung độ dương, hoành độ âm."
    },
    {
     "content": "Với mọi số thực $a$, $\\sin 2a$ bằng",
     "imageUrl": "",
     "options": [
      {
       "l": "A",
       "t": "$2\\sin a\\cos a$"
      },
      {
       "l": "B",
       "t": "$\\sin^2 a-\\cos^2 a$"
      },
      {
       "l": "C",
       "t": "$2\\sin a$"
      },
      {
       "l": "D",
       "t": "$\\cos^2 a-\\sin^2 a$"
      }
     ],
     "correct": "A",
     "expl": "Công thức nhân đôi."
    },
    {
     "content": "Giá trị của $\\cos^2 15^\\circ-\\sin^2 15^\\circ$ bằng",
     "imageUrl": "",
     "options": [
      {
       "l": "A",
       "t": "$1$"
      },
      {
       "l": "B",
       "t": "$\\frac{1}{2}$"
      },
      {
       "l": "C",
       "t": "$\\frac{\\sqrt{3}}{2}$"
      },
      {
       "l": "D",
       "t": "$\\frac{\\sqrt{2}}{2}$"
      }
     ],
     "correct": "C",
     "expl": "$\\cos^2 15^\\circ-\\sin^2 15^\\circ=\\cos 30^\\circ=\\frac{\\sqrt{3}}{2}$."
    },
    {
     "content": "Hàm số $y=\\tan x$ tuần hoàn với chu kì",
     "imageUrl": "",
     "options": [
      {
       "l": "A",
       "t": "$\\frac{\\pi}{2}$"
      },
      {
       "l": "B",
       "t": "$2\\pi$"
      },
      {
       "l": "C",
       "t": "$\\pi$"
      },
      {
       "l": "D",
       "t": "$\\frac{3\\pi}{2}$"
      }
     ],
     "correct": "C",
     "expl": "$y=\\tan x$ có chu kì $\\pi$."
    },
    {
     "content": "Nghiệm của phương trình $\\cos x=0$ là",

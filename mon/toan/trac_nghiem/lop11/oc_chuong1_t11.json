       "l": "C",
       "t": "$x=\\frac{\\pi}{2}+k2\\pi\\ (k\\in\\mathbb{Z})$"
      },
      {
       "l": "D",
       "t": "$x=k2\\pi\\ (k\\in\\mathbb{Z})$"
      }

  {
   "type": "tf",
   "title": "PHẦN II. Câu trắc nghiệm đúng sai",
   "maxPoints": 2,
   "questions": [
    {
     "content": "Cho góc $\\alpha$ thỏa mãn $\\sin\\alpha=\\frac{3}{5}$ và $\\frac{\\pi}{2}<\\alpha<\\pi$.",
     "imageUrl": "",
     "statements": [
      {
       "text": "$\\cos\\alpha<0$.",
       "correct": true,
       "expl": "Góc thuộc góc phần tư thứ II nên $\\cos\\alpha<0$."
      },
      {
       "text": "$\\cos 2\\alpha=-\\frac{7}{25}$.",
       "correct": false,
       "expl": "$\\cos 2\\alpha=1-2\\sin^2\\alpha=1-\\frac{18}{25}=\\frac{7}{25}$."
      },
      {
       "text": "$\\sin 2\\alpha=\\frac{24}{25}$.",
       "correct": false,
       "expl": "$\\cos\\alpha=-\\frac{4}{5}$ nên $\\sin 2\\alpha=2\\cdot\\frac{3}{5}\\cdot\\left(-\\frac{4}{5}\\right)=-\\frac{24}{25}$."
      },
      {
       "text": "Trên đoạn $[0;2\\pi]$, phương trình $\\sin x=\\frac{3}{5}$ có đúng hai nghiệm và $\\alpha$ là nghiệm lớn hơn.",
       "correct": true,
       "expl": "Hai nghiệm là $x_0$ và $\\pi-x_0$ với $x_0\\in\\left(0;\\frac{\\pi}{2}\\right)$; nghiệm $\\pi-x_0\\in\\left(\\frac{\\pi}{2};\\pi\\right)$ chính là $\\alpha$."
      }
     ]
    },
    {
     "content": "Nhiệt độ ngoài trời (°C) ở xã Vĩnh Thạnh trong một ngày được mô hình hóa bởi $T(t)=26+4\\sin\\frac{\\pi(t-9)}{12}$, với $t$ (giờ) tính từ 0 giờ, $0\\le t\\le 24$.",
     "imageUrl": "",
     "statements": [
      {
       "text": "Hàm số $T(t)$ tuần hoàn với chu kì 24 giờ.",
       "correct": true,
       "expl": "Chu kì $\\frac{2\\pi}{\\pi/12}=24$."
      },
      {
       "text": "Nhiệt độ cao nhất trong ngày là $30^\\circ$C.",
       "correct": true,
       "expl": "$\\sin\\le 1$ nên $T\\le 30$, đạt khi $t=15$."
      },
      {
       "text": "Lúc 9 giờ nhiệt độ là $30^\\circ$C.",
       "correct": false,
       "expl": "$T(9)=26+4\\sin 0=26$ (°C)."
      },
      {
       "text": "Trong ngày, nhiệt độ bằng $28^\\circ$C tại đúng hai thời điểm là 11 giờ và 19 giờ.",
       "correct": true,
       "expl": "$\\sin\\frac{\\pi(t-9)}{12}=\\frac{1}{2}\\Leftrightarrow t-9=2+24k$ hoặc $t-9=10+24k$; trên $[0;24]$ được $t=11$, $t=19$."
      }
     ]
    }
   ]
  },

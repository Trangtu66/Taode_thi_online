  {
   "type": "tf",
   "title": "PHẦN II. Câu trắc nghiệm đúng sai",
   "maxPoints": 1,
   "questions": [
    {
     "content": "Cho góc $\\alpha$ thỏa mãn $\\cos\\alpha=-\\frac{4}{5}$ và $\\pi<\\alpha<\\frac{3\\pi}{2}$.",
     "imageUrl": "",
     "statements": [
      {
       "text": "$\\sin\\alpha<0$.",
       "correct": true,
       "expl": "Góc phần tư thứ III nên $\\sin\\alpha<0$."
      },
      {
       "text": "$\\tan\\alpha=\\frac{3}{4}$.",
       "correct": true,
       "expl": "$\\sin\\alpha=-\\frac{3}{5}$ nên $\\tan\\alpha=\\frac{-3/5}{-4/5}=\\frac{3}{4}$."
      },
      {
       "text": "$\\sin 2\\alpha=-\\frac{24}{25}$.",
       "correct": false,
       "expl": "$\\sin 2\\alpha=2\\cdot\\left(-\\frac{3}{5}\\right)\\left(-\\frac{4}{5}\\right)=\\frac{24}{25}$."
      },
      {
       "text": "Trên khoảng $(0;2\\pi)$, phương trình $\\cos x=-\\frac{4}{5}$ có đúng hai nghiệm và $\\alpha$ là nghiệm lớn hơn.",
       "correct": true,
       "expl": "Hai nghiệm là $x_0\\in\\left(\\frac{\\pi}{2};\\pi\\right)$ và $2\\pi-x_0\\in\\left(\\pi;\\frac{3\\pi}{2}\\right)$; nghiệm sau chính là $\\alpha$."
      }
     ]
    },
    {
     "content": "Một cabin vòng quay ở độ cao $h(t)=20-18\\cos\\frac{\\pi t}{15}$ (mét) sau $t$ phút kể từ lúc bắt đầu quay.",
     "imageUrl": "",
     "statements": [
      {
       "text": "Tại $t=0$, cabin ở độ cao 20 m.",
       "correct": false,
       "expl": "$h(0)=20-18=2$ (m)."
      },
      {
       "text": "Vòng quay quay hết một vòng trong 30 phút.",
       "correct": true,
       "expl": "Chu kì $\\frac{2\\pi}{\\pi/15}=30$."
      },
      {
       "text": "Độ cao lớn nhất của cabin là 36 m.",
       "correct": false,
       "expl": "$\\cos\\ge -1$ nên $h\\le 38$ m, đạt tại $t=15$."
      },
      {
       "text": "Trong vòng quay đầu tiên ($0\\le t\\le 30$), thời gian cabin ở độ cao trên 29 m là 10 phút.",
       "correct": true,
       "expl": "$h>29\\Leftrightarrow\\cos\\frac{\\pi t}{15}<-\\frac{1}{2}\\Leftrightarrow\\frac{2\\pi}{3}<\\frac{\\pi t}{15}<\\frac{4\\pi}{3}\\Leftrightarrow 10<t<20$."
      }
     ]
    },
    {
     "content": "Cho cấp số cộng $(u_n)$ có $u_1=2$, công sai $d=3$ và dãy số $(v_n)$ với $v_n=2^{u_n}$.",
     "imageUrl": "",
     "statements": [
      {
       "text": "$(u_n)$ là dãy số tăng.",
       "correct": true,
       "expl": "$d=3>0$."
      },
      {
       "text": "$v_1=2$.",
       "correct": false,
       "expl": "$v_1=2^{u_1}=2^2=4$."
      },
      {
       "text": "$u_{10}=29$.",
       "correct": true,
       "expl": "$u_{10}=2+9\\cdot 3=29$."
      },
      {
       "text": "$(v_n)$ là cấp số nhân có công bội 8.",
       "correct": true,
       "expl": "$\\frac{v_{n+1}}{v_n}=2^{u_{n+1}-u_n}=2^3=8$."
      }
     ]
    },
    {
     "content": "Thời gian tự học (phút) mỗi ngày của 40 học sinh: $[0;20)$: 5; $[20;40)$: 9; $[40;60)$: 12; $[60;80)$: 10; $[80;100)$: 4.",
     "imageUrl": "",
     "statements": [
      {
       "text": "Giá trị đại diện của nhóm $[40;60)$ là 50.",
       "correct": true,
       "expl": "$\\frac{40+60}{2}=50$."
      },
      {
       "text": "Nhóm $[40;60)$ có tần số lớn nhất.",
       "correct": true,
       "expl": "Tần số 12 là lớn nhất."
      },
      {
       "text": "Số trung bình của mẫu số liệu là 50 phút.",
       "correct": false,
       "expl": "$\\bar x=\\frac{10\\cdot 5+30\\cdot 9+50\\cdot 12+70\\cdot 10+90\\cdot 4}{40}=49{,}5$."
      },
      {
       "text": "Trung vị của mẫu số liệu lớn hơn số trung bình.",
       "correct": true,
       "expl": "$M_e=40+\\frac{20-14}{12}\\cdot 20=50>49{,}5$."
      }
     ]
    }
   ]

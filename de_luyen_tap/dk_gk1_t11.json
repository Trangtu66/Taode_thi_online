    {
     "content": "Kim phút của một đồng hồ dài 10 cm. Trong 20 phút, đầu kim phút vạch nên cung tròn dài bao nhiêu cm (làm tròn đến hàng phần mười)?",
     "imageUrl": "",
     "answer": 20.9,
     "expl": "20 phút ứng với góc $\\frac{2\\pi}{3}$; $l=10\\cdot\\frac{2\\pi}{3}\\approx 20{,}94\\approx 20{,}9$ cm."
    },
    {
     "content": "Cho $\\cos a=\\frac{3}{5}$, $\\cos b=\\frac{4}{5}$ với $a, b\\in\\left(0;\\frac{\\pi}{2}\\right)$. Tính $\\cos(a-b)$.",
     "imageUrl": "",
     "answer": 0.96,
     "expl": "$\\sin a=\\frac{4}{5}$, $\\sin b=\\frac{3}{5}$; $\\cos(a-b)=\\frac{12}{25}+\\frac{12}{25}=\\frac{24}{25}=0{,}96$."
    },
    {
     "content": "Mực nước ở một cảng được mô hình hóa bởi $h(t)=4+3\\sin\\frac{\\pi t}{12}$ (m), $0\\le t\\le 24$ (giờ). Mực nước cao nhất lúc mấy giờ?",
     "imageUrl": "",
     "answer": 6,
     "expl": "$h$ lớn nhất khi $\\sin\\frac{\\pi t}{12}=1\\Leftrightarrow t=6$ (trên $[0;24]$)."
    },
    {
     "content": "Phương trình $2\\sin x-1=0$ có bao nhiêu nghiệm trên đoạn $[0;4\\pi]$?",
     "imageUrl": "",
     "answer": 4,
     "expl": "$\\sin x=\\frac{1}{2}$: $x=\\frac{\\pi}{6},\\frac{5\\pi}{6},\\frac{13\\pi}{6},\\frac{17\\pi}{6}$ – có 4 nghiệm."
    },
    {
     "content": "Cho dãy số $(u_n)$ với $u_n=n^2-2n$. Tính $u_4$.",
     "imageUrl": "",
     "answer": 8,
     "expl": "$u_4=16-8=8$."
    },
    {
     "content": "Cấp số cộng $(u_n)$ có $u_2=7$ và $u_5=16$. Tính tổng 10 số hạng đầu.",
     "imageUrl": "",
     "answer": 175,
     "expl": "$3d=9\\Rightarrow d=3$, $u_1=4$; $S_{10}=\\frac{10}{2}[8+27]=175$."
    }
   ]

     "options": [
      {
       "l": "A",
       "t": "$u_n=u_1q^{n-1}$"
      },
      {
       "l": "B",
       "t": "$u_n=u_1q^n$"
      },
      {
       "l": "C",
       "t": "$u_n=u_1+(n-1)q$"
      },
      {
       "l": "D",
       "t": "$u_n=u_1+q^{n-1}$"
      }
     ],
     "correct": "A",
     "expl": "$u_n=u_1\\cdot q^{n-1}$."
    },
    {
     "content": "Công bội của cấp số nhân $5,\\ 10,\\ 20,\\ \\ldots$ là",

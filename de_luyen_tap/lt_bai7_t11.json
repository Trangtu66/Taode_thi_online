     "options": [
      {
       "l": "A",
       "t": "$48$"
      },
      {
       "l": "B",
       "t": "$24$"
      },
      {
       "l": "C",
       "t": "$12$"
      },
      {
       "l": "D",
       "t": "$18$"
      }
     ],
     "correct": "B",
     "expl": "$u_4=u_1q^3=3\\cdot 8=24$."
    },
    {
     "content": "Dãy số hữu hạn nào sau đây là cấp số nhân?",
     "imageUrl": "",
     "options": [
      {
       "l": "A",
       "t": "$3,\\ 6,\\ 12,\\ 18$"
      },
      {
       "l": "B",
       "t": "$2,\\ 4,\\ 6,\\ 8$"

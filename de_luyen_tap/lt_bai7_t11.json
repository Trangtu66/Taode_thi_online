  {
   "type": "tf",
   "title": "PHẦN II. Câu trắc nghiệm đúng sai",
   "maxPoints": 2,
   "questions": [
    {
     "content": "Cho cấp số nhân $(u_n)$ có $u_2=6$ và $u_5=162$.",
     "imageUrl": "",
     "statements": [
      {
       "text": "Công bội $q=3$.",
       "correct": true,
       "expl": "$q^3=\\frac{162}{6}=27\\Rightarrow q=3$."
      },
      {
       "text": "$u_1=2$.",
       "correct": true,
       "expl": "$u_1=\\frac{u_2}{q}=2$."
      },
      {
       "text": "$S_4=60$.",
       "correct": false,
       "expl": "$S_4=\\frac{2(3^4-1)}{3-1}=80$."
      },
      {
       "text": "Số $1458$ là số hạng thứ 7 của cấp số nhân.",
       "correct": true,
       "expl": "$u_7=2\\cdot 3^6=1458$."
      }
     ]
    },
    {
     "content": "Năm 2025, sản lượng cà phê của một hộ gia đình ở xã Vĩnh Thạnh là 6 tấn; dự kiến mỗi năm sau tăng $5\\%$ so với năm trước. Gọi $u_n$ (tấn) là sản lượng năm thứ $n$ tính từ năm 2025 ($u_1=6$).",
     "imageUrl": "",
     "statements": [
      {
       "text": "Sản lượng năm 2026 là 6,3 tấn.",
       "correct": true,
       "expl": "$u_2=6\\cdot 1{,}05=6{,}3$."
      },
      {
       "text": "$(u_n)$ là cấp số nhân có công bội $q=0{,}05$.",
       "correct": false,
       "expl": "Công bội $q=1+5\\%=1{,}05$."
      },
      {
       "text": "Sản lượng năm 2030 khoảng 7,66 tấn.",
       "correct": true,
       "expl": "$u_6=6\\cdot 1{,}05^5\\approx 7{,}66$."
      },
      {
       "text": "Tổng sản lượng 5 năm từ 2025 đến 2029 vượt 33 tấn.",
       "correct": true,
       "expl": "$S_5=\\frac{6(1{,}05^5-1)}{0{,}05}\\approx 33{,}15$ (tấn)."
      }
     ]
    }
   ]
  },

  "parts": [
    {
      "type": "mcq",
      "title": "PHẦN I. Câu trắc nghiệm nhiều phương án lựa chọn",
      "pointsPerQuestion": 1,
      "questions": [
        {
          "content": "Đổi số đo góc $150^\\circ$ sang rađian, ta được",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$\\frac{3\\pi}{4}$"
            },
            {
              "l": "B",
              "t": "$\\frac{5\\pi}{6}$"
            },
            {
              "l": "C",
              "t": "$\\frac{2\\pi}{3}$"
            },
            {
              "l": "D",
              "t": "$\\frac{6\\pi}{5}$"
            }
          ],
          "correct": "B",
          "expl": "$150^\\circ=150\\cdot\\frac{\\pi}{180}=\\frac{5\\pi}{6}$."
        },
        {
          "content": "Hàm số nào sau đây là hàm số chẵn?",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$y=\\tan x$"
            },
            {
              "l": "B",
              "t": "$y=\\sin x$"
            },
            {
              "l": "C",
              "t": "$y=\\cos x$"
            },
            {
              "l": "D",
              "t": "$y=\\cot x$"
            }
          ],
          "correct": "C",
          "expl": "$\\cos(-x)=\\cos x$ với mọi $x\\in\\mathbb{R}$ nên $y=\\cos x$ là hàm số chẵn; ba hàm số còn lại là hàm số lẻ."
        },
        {
          "content": "Cho $\\sin\\alpha=\\frac{3}{5}$ với $\\frac{\\pi}{2}<\\alpha<\\pi$. Giá trị của $\\cos\\alpha$ bằng",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$-\\frac{4}{5}$"
            },
            {
              "l": "B",
              "t": "$\\frac{4}{5}$"
            },
            {
              "l": "C",
              "t": "$-\\frac{3}{5}$"
            },
            {
              "l": "D",
              "t": "$\\frac{16}{25}$"
            }
          ],
          "correct": "A",
          "expl": "$\\cos^2\\alpha=1-\\frac{9}{25}=\\frac{16}{25}$; vì $\\frac{\\pi}{2}<\\alpha<\\pi$ nên $\\cos\\alpha<0$, do đó $\\cos\\alpha=-\\frac{4}{5}$."
        },
        {
          "content": "Với mọi số thực $a$, $b$, biểu thức $\\cos(a-b)$ bằng",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$\\cos a-\\cos b$"
            },
            {
              "l": "B",
              "t": "$\\cos a\\cos b-\\sin a\\sin b$"
            },
            {
              "l": "C",
              "t": "$\\sin a\\cos b-\\cos a\\sin b$"
            },
            {
              "l": "D",
              "t": "$\\cos a\\cos b+\\sin a\\sin b$"
            }
          ],
          "correct": "D",
          "expl": "Công thức cộng: $\\cos(a-b)=\\cos a\\cos b+\\sin a\\sin b$."
        },
        {
          "content": "Nghiệm của phương trình $\\tan x=1$ là",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$x=\\frac{\\pi}{4}+k2\\pi\\ (k\\in\\mathbb{Z})$"
            },
            {
              "l": "B",
              "t": "$x=\\frac{\\pi}{4}+k\\pi\\ (k\\in\\mathbb{Z})$"
            },
            {
              "l": "C",
              "t": "$x=\\pm\\frac{\\pi}{4}+k2\\pi\\ (k\\in\\mathbb{Z})$"
            },
            {
              "l": "D",
              "t": "$x=\\frac{\\pi}{2}+k\\pi\\ (k\\in\\mathbb{Z})$"
            }
          ],
          "correct": "B",
          "expl": "$\\tan x=\\tan\\frac{\\pi}{4}\\Leftrightarrow x=\\frac{\\pi}{4}+k\\pi$ (hàm tang tuần hoàn chu kì $\\pi$)."
        },
        {
          "content": "Số nghiệm của phương trình $2\\cos x=1$ trên đoạn $[0;2\\pi]$ là",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$3$"
            },
            {
              "l": "B",
              "t": "$1$"
            },
            {
              "l": "C",
              "t": "$2$"
            },
            {
              "l": "D",
              "t": "$4$"
            }
          ],
          "correct": "C",
          "expl": "$\\cos x=\\frac{1}{2}\\Leftrightarrow x=\\pm\\frac{\\pi}{3}+k2\\pi$. Trên $[0;2\\pi]$: $x=\\frac{\\pi}{3}$ và $x=\\frac{5\\pi}{3}$ – có 2 nghiệm."
        }
      ]
    },
    {
      "type": "tf",
      "title": "PHẦN II. Câu trắc nghiệm đúng sai",
      "maxPoints": 4,
      "questions": [
        {
          "content": "(Vận dụng – thực tiễn) Một guồng nước tưới cà phê ở xã Vĩnh Thạnh quay đều, mỗi vòng hết 30 giây. Độ cao (so với mặt nước) của một gầu nước sau $t$ giây được mô hình hoá bởi $h(t)=2{,}5+2\\sin\\frac{\\pi t}{15}$ (m). Xét tính đúng, sai của các khẳng định sau:",
          "imageUrl": "",
          "statements": [
            {
              "text": "Hàm số $h(t)$ tuần hoàn với chu kì 30 giây.",
              "correct": true,
              "expl": "Chu kì $T=\\frac{2\\pi}{\\pi/15}=30$ (giây)."
            },
            {
              "text": "Độ cao lớn nhất của gầu nước là 4,5 m.",
              "correct": true,
              "expl": "$\\sin\\frac{\\pi t}{15}\\le 1$ nên $h(t)\\le 2{,}5+2=4{,}5$ (m), đạt khi $t=7{,}5$ giây."
            },
            {
              "text": "Tại thời điểm $t=5$ giây, gầu nước ở độ cao 3,5 m.",
              "correct": false,
              "expl": "$h(5)=2{,}5+2\\sin\\frac{\\pi}{3}=2{,}5+\\sqrt{3}\\approx 4{,}23$ (m)."
            },
            {
              "text": "Trong 30 giây đầu tiên ($0\\le t<30$), có đúng 2 thời điểm gầu nước ở độ cao 3,5 m.",
              "correct": true,
              "expl": "$h(t)=3{,}5\\Leftrightarrow\\sin\\frac{\\pi t}{15}=\\frac{1}{2}\\Leftrightarrow\\frac{\\pi t}{15}=\\frac{\\pi}{6}$ hoặc $\\frac{5\\pi}{6}$ (trong một chu kì), tức $t=2{,}5$ hoặc $t=12{,}5$."
            }
          ]
        }
      ]
    }

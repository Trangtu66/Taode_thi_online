    {
      "type": "tf",
      "title": "PHẦN II. Câu trắc nghiệm đúng sai",
      "maxPoints": 4,
      "questions": [
        {
          "content": "(Vận dụng – thực tiễn) Hồ nước tự nhiên hình tam giác $ABC$ ở địa phương có $AB=500$ m, $AC=700$ m, $\\widehat{A}=60^\\circ$. Xét tính đúng/sai của các khẳng định:",
          "imageUrl": "",
          "statements": [
            {
              "text": "$BC^2 = AB^2 + AC^2 - AB \\cdot AC = 250\\,000 + 490\\,000 - 350\\,000 = 390\\,000$.",
              "correct": true,
              "expl": "$BC^2 = 500^2+700^2-2\\cdot500\\cdot700\\cos60^\\circ=740\\,000-350\\,000=390\\,000$ ✓."
            },
            {
              "text": "Diện tích $S = \\dfrac{1}{2}\\cdot500\\cdot700\\cdot\\sin60^\\circ = \\dfrac{175\\,000\\sqrt{3}}{2}$ m$^2$.",
              "correct": true,
              "expl": "$S=\\dfrac{1}{2}\\cdot500\\cdot700\\cdot\\dfrac{\\sqrt{3}}{2}=\\dfrac{175\\,000\\sqrt{3}}{2}\\approx151\\,554$ m$^2$ ✓."
            },
            {
              "text": "Bán kính đường tròn ngoại tiếp $R = \\dfrac{BC}{2\\sin A} > 400$ m.",
              "correct": false,
              "expl": "$BC=\\sqrt{390\\,000}\\approx624$ m; $R=\\dfrac{624}{2\\sin60^\\circ}=\\dfrac{624}{\\sqrt{3}}\\approx360$ m $<400$ m."
            },
            {
              "text": "Chu vi tam giác vượt $1\\,800$ m.",
              "correct": true,
              "expl": "$AB+AC+BC=500+700+624=1\\,824$ m $>1\\,800$ m ✓."
            }
          ]
        }
      ]
    }

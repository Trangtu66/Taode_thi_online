              "l": "C",
              "t": "$3\\sqrt{3}$"
            },
            {
              "l": "D",
              "t": "$\\dfrac{3\\sqrt{3}}{2}$"
            }
          ],
          "correct": "B",
          "expl": "$S=\\dfrac{36\\sqrt{3}}{4}=9\\sqrt{3}$; $p=9$; $r=\\dfrac{S}{p}=\\sqrt{3}$."
        },
        {
          "content": "Tam giác $ABC$ có $\\widehat{B}=135^\\circ$, $a=4$, $c=2$. Diện tích tam giác bằng",
          "imageUrl": "",
          "options": [

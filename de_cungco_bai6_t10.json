  "parts": [
    {
      "type": "mcq",
      "title": "PHẦN I. Câu trắc nghiệm nhiều phương án lựa chọn",
      "pointsPerQuestion": 1,
      "questions": [
        {
          "content": "Trong tam giác $ABC$ (với $a=BC$, $b=CA$, $c=AB$), khẳng định nào sau đây đúng?",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$a^2=b^2+c^2-2bc\\cos A$"
            },
            {
              "l": "B",
              "t": "$a^2=b^2+c^2+2bc\\cos A$"
            },
            {
              "l": "C",
              "t": "$a^2=b^2+c^2-bc\\cos A$"
            },
            {
              "l": "D",
              "t": "$a^2=b^2+c^2-2bc\\sin A$"
            }
          ],
          "correct": "A",
          "expl": "Định lí côsin: $a^2=b^2+c^2-2bc\\cos A$."
        },
        {
          "content": "Trong tam giác $ABC$ có bán kính đường tròn ngoại tiếp $R$, tỉ số $\\frac{a}{\\sin A}$ bằng",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$2R$"
            },
            {
              "l": "B",
              "t": "$R$"
            },
            {
              "l": "C",
              "t": "$\\frac{R}{2}$"
            },
            {
              "l": "D",
              "t": "$4R$"
            }
          ],
          "correct": "A",
          "expl": "Định lí sin: $\\frac{a}{\\sin A}=\\frac{b}{\\sin B}=\\frac{c}{\\sin C}=2R$."
        },
        {
          "content": "Tam giác $ABC$ có $b=3$, $c=5$, $\\widehat{A}=60^\\circ$. Độ dài cạnh $a$ bằng",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$\\sqrt{19}$"
            },
            {
              "l": "B",
              "t": "$7$"
            },
            {
              "l": "C",
              "t": "$\\sqrt{34}$"
            },
            {
              "l": "D",
              "t": "$4$"
            }
          ],
          "correct": "A",
          "expl": "$a^2=9+25-2\\cdot 3\\cdot 5\\cdot\\cos 60^\\circ=34-15=19$ nên $a=\\sqrt{19}$. (Phương án 7 do nhầm dấu thành $+2bc\\cos A$.)"
        },
        {
          "content": "Tam giác $ABC$ có $a=6$ và $\\widehat{A}=30^\\circ$. Bán kính đường tròn ngoại tiếp tam giác bằng",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$6$"
            },
            {
              "l": "B",
              "t": "$12$"
            },
            {
              "l": "C",
              "t": "$3$"
            },
            {
              "l": "D",
              "t": "$6\\sqrt{3}$"
            }
          ],
          "correct": "A",
          "expl": "$2R=\\frac{a}{\\sin A}=\\frac{6}{0{,}5}=12$ nên $R=6$. (Phương án 12 là $2R$.)"
        },
        {
          "content": "Tam giác $ABC$ có $b=4$, $c=5$, $\\widehat{A}=150^\\circ$. Diện tích tam giác bằng",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$5$"
            },
            {
              "l": "B",
              "t": "$10$"
            },
            {
              "l": "C",
              "t": "$5\\sqrt{3}$"
            },
            {
              "l": "D",
              "t": "$10\\sqrt{3}$"
            }
          ],
          "correct": "A",
          "expl": "$S=\\frac{1}{2}bc\\sin A=\\frac{1}{2}\\cdot 4\\cdot 5\\cdot\\sin 150^\\circ=10\\cdot\\frac{1}{2}=5$."
        },
        {
          "content": "Một mảnh vườn hình tam giác có ba cạnh dài 5 m, 6 m và 7 m. Diện tích mảnh vườn bằng",
          "imageUrl": "",
          "options": [
            {
              "l": "A",
              "t": "$6\\sqrt{6}$ m²"
            },
            {
              "l": "B",
              "t": "$12$ m²"
            },
            {
              "l": "C",
              "t": "$6\\sqrt{5}$ m²"
            },
            {
              "l": "D",
              "t": "$18$ m²"
            }
          ],
          "correct": "A",
          "expl": "Nửa chu vi $p=9$. Công thức Heron: $S=\\sqrt{9\\cdot 4\\cdot 3\\cdot 2}=\\sqrt{216}=6\\sqrt{6}\\approx 14{,}7$ (m²)."
        }
      ]
    },
    {
      "type": "tf",
      "title": "PHẦN II. Câu trắc nghiệm đúng sai",
      "maxPoints": 4,
      "questions": [
        {
          "content": "(Vận dụng – thực tiễn) Để đo khoảng cách từ vị trí $A$ trên bờ Biển Hồ (Pleiku, Gia Lai) đến một cây thông $C$ mọc ven hồ phía đối diện, bạn Nam cắm cọc tiêu tại $A$ và $B$ trên bờ với $AB=50$ m, rồi đo được $\\widehat{CAB}=60^\\circ$, $\\widehat{CBA}=75^\\circ$. Xét tính đúng, sai của các khẳng định sau:",
          "imageUrl": "",
          "statements": [
            {
              "text": "$\\widehat{ACB}=45^\\circ$.",
              "correct": true,
              "expl": "$\\widehat{ACB}=180^\\circ-(60^\\circ+75^\\circ)=45^\\circ$."
            },
            {
              "text": "$AC=\\frac{50\\sin 75^\\circ}{\\sin 45^\\circ}\\approx 68{,}3$ m.",
              "correct": true,
              "expl": "Định lí sin: $\\frac{AC}{\\sin B}=\\frac{AB}{\\sin C}$ nên $AC=\\frac{50\\sin 75^\\circ}{\\sin 45^\\circ}\\approx 68{,}3$ (m)."
            },
            {
              "text": "$BC\\approx 70{,}7$ m.",
              "correct": false,
              "expl": "$BC=\\frac{50\\sin 60^\\circ}{\\sin 45^\\circ}\\approx 61{,}2$ (m)."
            },
            {
              "text": "Khoảng cách từ cây thông $C$ đến đường thẳng $AB$ lớn hơn 60 m.",
              "correct": false,
              "expl": "Khoảng cách đó là $CH=AC\\cdot\\sin 60^\\circ\\approx 68{,}3\\cdot 0{,}866\\approx 59{,}2$ (m) $<60$ m."
            }
          ]
        }
      ]
    }
  ],
